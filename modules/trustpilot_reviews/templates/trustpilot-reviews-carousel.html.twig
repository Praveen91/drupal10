{#
/**
 * @file
 * Default theme implementation for Trustpilot reviews carousel.
 *
 * Available variables:
 * - reviews: Array of review data.
 * - show_title: Boolean indicating whether to show the block title.
 * - block_title: The title of the block.
 * - autoplay: Boolean indicating whether autoplay is enabled.
 * - autoplay_delay: Autoplay delay in milliseconds.
 */
#}

<div class="trustpilot-reviews-wrapper">
  {% if show_title and block_title %}
    <h2 class="trustpilot-reviews-title">{{ block_title }}</h2>
  {% endif %}
  
  <div class="trustpilot-reviews-carousel swiper" 
       data-autoplay="{{ autoplay ? 'true' : 'false' }}" 
       data-delay="{{ autoplay_delay }}">
    <div class="swiper-wrapper">
      {% for review in reviews %}
        <div class="swiper-slide">
          <div class="trustpilot-review-card">
            <div class="review-header">
              <div class="review-rating">
                {% for i in 1..5 %}
                  <span class="star {{ i <= review.rating ? 'filled' : 'empty' }}">★</span>
                {% endfor %}
              </div>
              <div class="review-date">{{ review.date|date('M j, Y') }}</div>
            </div>
            
            <h3 class="review-title">{{ review.title }}</h3>
            <p class="review-content">{{ review.content }}</p>
            
            <div class="review-author">
              <div class="author-avatar">
                <span>{{ review.author|first|upper }}</span>
              </div>
              <div class="author-name">{{ review.author }}</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    <!-- Navigation buttons -->
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    
    <!-- Pagination -->
    <div class="swiper-pagination"></div>
  </div>
</div>